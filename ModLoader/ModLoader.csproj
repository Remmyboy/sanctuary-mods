<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>ModLoader</AssemblyName>
    <!-- The loader is the stable half: it lives in plugins\ (loaded normally
         by BepInEx) and rarely changes. It is the one file that must sit
         inside the BepInEx tree — everything it loads does not. -->
    <DeployPath>$(GamePath)\BepInEx\plugins</DeployPath>
    <!-- Loaded from disk by identity, so keep a fixed version. -->
    <Deterministic>true</Deterministic>
    <AssemblyVersion>1.4.1</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- mod.json's "kind", read as the Mod API reads it; the game ships Newtonsoft. -->
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(GamePath)\Sanctuary_Data\Managed\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
