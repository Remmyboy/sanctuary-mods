<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>SanctuaryHudLoader</AssemblyName>
    <!-- The loader is the stable half: it lives in plugins\ (loaded normally
         by BepInEx) and rarely changes. -->
    <DeployFolder>plugins</DeployFolder>
    <!-- Loaded from disk by identity, so keep a fixed version. -->
    <Deterministic>true</Deterministic>
    <AssemblyVersion>1.1.0</AssemblyVersion>
  </PropertyGroup>

</Project>
