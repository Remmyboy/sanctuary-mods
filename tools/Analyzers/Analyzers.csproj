<Project Sdk="Microsoft.NET.Sdk">

  <!-- Repo-specific checks the stock analyzers don't make, run by every mod's
       build (Directory.Build.props references this as an analyzer). Rules
       and why: tools/Analyzers/ModAnalyzer.cs. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <!-- No AnalyzerReleases.*.md tracking: the rules ship with the repo. -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
