<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>ModManager</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- The manager builds its page out of the game's own Beam UI widgets
         (TextMeshPro text, animated panels), so it needs these on top of the
         shared references. -->
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(GamePath)\Sanctuary_Data\Managed\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Michsky.UI.Beam">
      <HintPath>$(GamePath)\Sanctuary_Data\Managed\Michsky.UI.Beam.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(GamePath)\Sanctuary_Data\Managed\UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Updates: UnityWebRequest for GitHub (Mono's own TLS fails against
         modern cert chains), the game's Newtonsoft for the release list, and
         ZipArchive for the release zips. -->
    <Reference Include="UnityEngine.UnityWebRequestModule">
      <HintPath>$(GamePath)\Sanctuary_Data\Managed\UnityEngine.UnityWebRequestModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(GamePath)\Sanctuary_Data\Managed\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.IO.Compression" />
  </ItemGroup>

  <ItemGroup>
    <!-- The mod API, loaded by BepInEx from plugins\ under a fixed identity:
         referenced, never copied beside this DLL. -->
    <ProjectReference Include="..\ModApi\ModApi.csproj" Private="false" />
  </ItemGroup>

</Project>
