<Project>

  <!-- Deploy every built assembly into the game. Mods go to BepInEx\scripts
       (watched and hot-reloaded by the loader); the loader project overrides
       DeployFolder to plugins, where BepInEx loads it normally. -->
  <Target Name="DeployToGame" AfterTargets="Build" Condition="Exists('$(GamePath)\BepInEx\$(DeployFolder)')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GamePath)\BepInEx\$(DeployFolder)" />
    <Message Importance="high" Text="Deployed $(AssemblyName).dll to $(GamePath)\BepInEx\$(DeployFolder)" />
  </Target>

</Project>
