<Project>

  <!-- shared/Stats (the match-stats Lua collector and its parser) is
       compiled only into the mods that read match stats, the ones setting
       SharedMatchStats (SanctuaryHud, LadderReporter); every other mod's
       ..\shared\** glob leaves it out here. Items are evaluated after the
       project body, so this Remove sees what the csproj included. -->
  <ItemGroup Condition="'$(SharedMatchStats)' != 'true'">
    <Compile Remove="$(MSBuildThisFileDirectory)shared\Stats\**" />
  </ItemGroup>

  <!-- Where each project lands in the game install. Mods go to their own
       folder under SanctuaryMods (the loader scans those and hot-reloads
       them); the loader project overrides DeployPath to BepInEx\plugins,
       where BepInEx loads it normally. -->
  <PropertyGroup>
    <DeployPath Condition="'$(DeployPath)' == ''">$(GamePath)\SanctuaryMods\$(AssemblyName)</DeployPath>
  </PropertyGroup>

  <!-- A deploy into the game folder hot-loads into a running game, which may
       be a real match. While Sanctuary is running, builds compile but do not
       deploy unless -p:LiveDeploy=true says the hot load is wanted. A
       DeployPath outside the game folder (a scratch dir) is always fine. -->
  <Target Name="CheckGameRunning" Condition="Exists('$(GamePath)') And '$(LiveDeploy)' != 'true' And $([System.String]::Copy('$(DeployPath)').StartsWith('$(GamePath)'))">
    <Exec Command="tasklist /FI &quot;IMAGENAME eq Sanctuary.exe&quot; /NH" ConsoleToMSBuild="true" StandardOutputImportance="low" EchoOff="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_TaskList" />
    </Exec>
    <PropertyGroup>
      <_SkipDeploy Condition="$(_TaskList.Contains('Sanctuary.exe'))">true</_SkipDeploy>
    </PropertyGroup>
    <Warning Condition="'$(_SkipDeploy)' == 'true'" Text="Sanctuary is running: built $(AssemblyName) but did NOT deploy it (it would hot-load into the game). Rebuild with -p:LiveDeploy=true once that is OK." />
  </Target>

  <!-- Every worktree deploys to the same folder, so a build from a stale
       checkout can replace a newer one in the game and silently undo a fix
       (25 Nov 2026: a build from a checkout that had not pulled dropped the
       tier-tab fix). The SDK stamps the commit into ProductVersion
       (1.0.0+<sha>); a DLL in the game whose commit this checkout's HEAD does
       not contain is not replaced unless -p:ForceDeploy=true. A commit this
       repo doesn't know (a release build, a pruned branch) is let through.
       Uncommitted changes carry no stamp of their own and go unseen. -->
  <Target Name="CheckDeployedIsOlder" Condition="Exists('$(GamePath)') And '$(ForceDeploy)' != 'true' And '$(_SkipDeploy)' != 'true' And Exists('$(DeployPath)\$(TargetFileName)')">
    <!-- FileVersionInfo is not allowed in an MSBuild property function. -->
    <Exec Command="powershell -NoProfile -NonInteractive -Command &quot;(Get-Item -LiteralPath '$(DeployPath)\$(TargetFileName)').VersionInfo.ProductVersion&quot;" ConsoleToMSBuild="true" IgnoreExitCode="true" EchoOff="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_DeployedVersion" />
    </Exec>
    <PropertyGroup>
      <_DeployedVersion>$(_DeployedVersion.Trim())</_DeployedVersion>
      <_DeployedSha Condition="$(_DeployedVersion.Contains('+'))">$(_DeployedVersion.Substring($([MSBuild]::Add($(_DeployedVersion.IndexOf('+')), 1))))</_DeployedSha>
    </PropertyGroup>
    <Exec Condition="'$(_DeployedSha)' != ''" Command="git merge-base --is-ancestor $(_DeployedSha) HEAD" WorkingDirectory="$(MSBuildProjectDirectory)" IgnoreExitCode="true" EchoOff="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="_AncestorExit" />
    </Exec>
    <PropertyGroup>
      <_SkipDeploy Condition="'$(_AncestorExit)' == '1'">true</_SkipDeploy>
    </PropertyGroup>
    <Warning Condition="'$(_AncestorExit)' == '1'" Text="The $(AssemblyName).dll in the game was built from $(_DeployedSha.Substring(0, 7)), which this checkout's HEAD does not contain: built $(AssemblyName) but did NOT deploy it, or it would undo that build's changes. Merge or pull it in first (git merge-base --is-ancestor $(_DeployedSha.Substring(0, 7)) HEAD), or rebuild with -p:ForceDeploy=true to replace it anyway." />
  </Target>

  <!-- The skip is checked per task: a target's own Condition is evaluated
       before its DependsOnTargets run. -->
  <Target Name="DeployToGame" AfterTargets="Build" DependsOnTargets="CheckGameRunning;CheckDeployedIsOlder" Condition="Exists('$(GamePath)')">
    <MakeDir Condition="'$(_SkipDeploy)' != 'true'" Directories="$(DeployPath)" />
    <Copy Condition="'$(_SkipDeploy)' != 'true'" SourceFiles="$(TargetPath)" DestinationFolder="$(DeployPath)" />
    <Message Condition="'$(_SkipDeploy)' != 'true'" Importance="high" Text="Deployed $(AssemblyName).dll to $(DeployPath)" />
  </Target>

  <!-- Data a mod ships beside its DLL: anything under the project's sounds
       folder (SanctuaryHud's alert sounds) is deployed to <mod>\sounds, and
       tools\pack-release.ps1 puts the same folder in the release zips. -->
  <ItemGroup>
    <ModSoundFiles Include="$(MSBuildProjectDirectory)\sounds\**\*" />
  </ItemGroup>
  <Target Name="DeploySoundsToGame" AfterTargets="DeployToGame" Condition="Exists('$(GamePath)') And '@(ModSoundFiles)' != '' And '$(_SkipDeploy)' != 'true'">
    <Copy SourceFiles="@(ModSoundFiles)" DestinationFolder="$(DeployPath)\sounds\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Deployed sounds for $(AssemblyName)" />
  </Target>

</Project>
