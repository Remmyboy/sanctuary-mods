<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>SanctuaryHud</AssemblyName>
    <!-- Compiles shared/Stats (the match-stats collector); see Directory.Build.targets. -->
    <SharedMatchStats>true</SharedMatchStats>
  </PropertyGroup>

  <!-- The lobby's map list filters (MapPicker.cs) clone the game's Beam UI
       dropdowns and read .sanmap headers with the game's Newtonsoft. -->
  <ItemGroup>
    <Reference Include="Michsky.UI.Beam">
      <HintPath>$(GamePath)\Sanctuary_Data\Managed\Michsky.UI.Beam.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(GamePath)\Sanctuary_Data\Managed\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\shared\**\*.cs" Link="shared\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Right-click cursors (CursorHint.cs): Kenney's Cursor Pack, CC0; see cursors\License.txt. -->
  <ItemGroup>
    <EmbeddedResource Include="cursors\*.png" LogicalName="SanctuaryHud.cursors.%(Filename).png" />
  </ItemGroup>

</Project>
