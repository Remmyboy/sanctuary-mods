<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>SanctuaryHud</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\shared\**\*.cs" Link="shared\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- The strip borrows the game's typeface from its TextMeshPro font
         asset (see GamePanel.cs), which needs TMP on top of the shared
         references. The alert tones (Alerts.cs) reach UnityEngine.AudioModule
         by reflection instead: it is built against netstandard 2.1, which a
         net472 project cannot reference. -->
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(GamePath)\Sanctuary_Data\Managed\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
