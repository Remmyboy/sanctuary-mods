<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>LadderReporter</AssemblyName>
    <!-- Compiles shared/Stats (the match-stats collector); see Directory.Build.targets. -->
    <SharedMatchStats>true</SharedMatchStats>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\shared\**\*.cs" Link="shared\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Must bind to the game's own Steamworks.NET: its callback dispatcher
         is per-assembly, and only the game's copy is pumped every frame. -->
    <Reference Include="com.rlabrecque.steamworks.net">
      <HintPath>$(GamePath)\Sanctuary_Data\Managed\com.rlabrecque.steamworks.net.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Delivery uses UnityWebRequest: the engine's native TLS works where
         Mono's BCL HttpClient handshake fails against modern cert chains. -->
    <Reference Include="UnityEngine.UnityWebRequestModule">
      <HintPath>$(GamePath)\Sanctuary_Data\Managed\UnityEngine.UnityWebRequestModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Matchmaking parses the site's JSON; the game ships Newtonsoft. -->
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(GamePath)\Sanctuary_Data\Managed\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Live replays drive the game's replay socket (LiveWatch.cs), which
         touches the DOTS-side network structs. -->
    <Reference Include="Unity.Entities">
      <HintPath>$(GamePath)\Sanctuary_Data\Managed\Unity.Entities.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Collections">
      <HintPath>$(GamePath)\Sanctuary_Data\Managed\Unity.Collections.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Burst">
      <HintPath>$(GamePath)\Sanctuary_Data\Managed\Unity.Burst.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Mathematics">
      <HintPath>$(GamePath)\Sanctuary_Data\Managed\Unity.Mathematics.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
