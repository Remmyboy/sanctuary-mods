<Project Sdk="Microsoft.NET.Sdk">

  <!-- A complete, standalone mod project: copy this folder anywhere, or start
       from the template (templates\sanctuary-mod), and `dotnet build` puts the
       mod straight into the running game. -->
  <PropertyGroup>
    <AssemblyName>ExampleUiMod</AssemblyName>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <DebugType>none</DebugType>
    <!-- Where the game is. Override with -p:GamePath=... -->
    <GamePath Condition="'$(GamePath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Sanctuary Shattered Sun Playtest\engine</GamePath>
    <ModApiDll Condition="'$(ModApiDll)' == ''">$(GamePath)\BepInEx\plugins\Sanctuary.ModApi.dll</ModApiDll>
    <!-- The mod's folder under SanctuaryMods. -->
    <DeployPath Condition="'$(DeployPath)' == ''">$(GamePath)\SanctuaryMods\$(AssemblyName)</DeployPath>
    <!-- A new assembly version on every build, so the loader's hot reload
         never gets the previous build back from Mono's cache. -->
    <Deterministic>false</Deterministic>
    <AssemblyVersion>1.0.*</AssemblyVersion>
    <NoWarn>$(NoWarn);CS7035</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- Everything here is already in the game: referenced, never copied. -->
  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>$(GamePath)\BepInEx\core\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(GamePath)\BepInEx\core\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Sanctuary.ModApi"><HintPath>$(ModApiDll)</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(GamePath)\Sanctuary_Data\Managed\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GamePath)\Sanctuary_Data\Managed\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(GamePath)\Sanctuary_Data\Managed\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(GamePath)\Sanctuary_Data\Managed\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Trebuchet"><HintPath>$(GamePath)\Sanctuary_Data\Managed\Trebuchet.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <Target Name="DeployToGame" AfterTargets="Build" Condition="Exists('$(GamePath)')">
    <MakeDir Directories="$(DeployPath)" />
    <Copy SourceFiles="$(TargetPath);mod.json" DestinationFolder="$(DeployPath)" />
    <Message Importance="high" Text="Deployed $(AssemblyName) to $(DeployPath)" />
  </Target>

</Project>
